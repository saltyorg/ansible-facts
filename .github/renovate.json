{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable"
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "ansible": {
        "enabled": false
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Maintain the Rust requirement in Cargo.toml",
            "managerFilePatterns": ["/^Cargo\\.toml$/"],
            "matchStrings": [
                "(?:^|\\n)rust-version[ \\t]*=[ \\t]*\"(?<currentValue>[0-9]+(?:\\.[0-9]+){1,2})\""
            ],
            "depNameTemplate": "rust",
            "datasourceTemplate": "rust-version",
            "versioningTemplate": "rust-release-channel"
        },
        {
            "customType": "regex",
            "description": "Maintain annotated tool versions in workflows",
            "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[^\\n]*?(?:@|:\\s*)(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
            ]
        }
    ],
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "matchCategories": [
                "docker"
            ],
            "pinDigests": false
        },
        {
            "description": "Major GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "github-actions",
                "major"
            ]
        },
        {
            "description": "GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "description": "Cargo dependency ranges",
            "matchManagers": [
                "cargo"
            ],
            "rangeStrategy": "replace"
        },
        {
            "description": "Rust crate updates",
            "matchManagers": [
                "cargo"
            ],
            "groupName": "rust-crates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "labels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "description": "Workflow tool updates",
            "matchManagers": ["custom.regex"],
            "matchDepNames": ["!rust"],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "labels": ["dependencies", "github-actions"]
        },
        {
            "description": "Major Rust crate updates",
            "matchManagers": ["cargo"],
            "matchUpdateTypes": ["major"],
            "labels": ["dependencies", "rust", "major"]
        }
    ],
    "rebaseWhen": "behind-base-branch",
    "platformAutomerge": false,
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "automerge": true,
        "addLabels": [
            "security",
            "vulnerability"
        ]
    },
    "commitMessageAction": "Update",
    "commitMessageTopic": "{{depName}}",
    "commitMessageExtra": "to {{newVersion}}",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "schedule": ["before 5am"]
    }
}
